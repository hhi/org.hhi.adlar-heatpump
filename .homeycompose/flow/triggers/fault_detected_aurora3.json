    },
    {
      "type": "text",
      "name": "fault_code",
      "title": {
        "en": " code",
        "nl": " code",
        "de": " code",
        "fr": " code"
      },
      "placeholder": {
        "en": "Fault code to monitor, e.g. E03 or P17",
        "nl": "Storingscode om te monitoren, bijv. E03 of P17",
        "de": "Störungscode zur Überwachung, z. B. E03 oder P17",
        "fr": "Code de défaut à surveiller, p. ex. E03 ou P17"
      }
    }
  ],
  "tokens": [
    {
      "type": "string",
      "name": "fault_code",
      "title": {
        "en": "Fault code",
        "nl": "Storing code",
        "de": "Störungscode",
        "fr": "Code de défaut"
      },
      "example": "E03"
    },
    {
      "type": "string",
      "name": "fault_description",
      "title": {
        "en": "Fault description",
        "nl": "Storing beschrijving",
        "de": "Störungsbeschreibung",
