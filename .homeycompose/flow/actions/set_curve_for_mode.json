{
  "id": "set_curve_for_mode",
  "title": {
    "en": "Set curve (by mode)",
    "nl": "Curve instellen (per modus)",
    "de": "Kurve einstellen (nach Modus)",
    "fr": "Régler la courbe (par mode)"
  },
  "titleFormatted": {
    "en": "Set curve to [[curve]] for [[target]]",
    "nl": "Curve instellen op [[curve]] voor [[target]]",
    "de": "Kurve einstellen auf [[curve]] für [[target]]",
    "fr": "Régler la courbe sur [[curve]] pour [[target]]"
  },
  "hint": {
    "en": "Set the curve setting, routed to heating, cooling, floor heating, or hot water. Auto follows the heat pump's current mode.",
    "nl": "Stel de curve-instelling in, gericht op verwarmen, koelen, vloerverwarming of warm water. Auto volgt de huidige modus van de warmtepomp.",
    "de": "Kurveneinstellung einstellen, geleitet an Heizen, Kühlen, Fußbodenheizung oder Warmwasser. Auto folgt dem aktuellen Modus der Wärmepumpe.",
    "fr": "Régler la courbe, dirigée vers chauffage, refroidissement, plancher chauffant ou eau chaude. Auto suit le mode actuel de la pompe à chaleur."
  },
  "highlight": true,
  "args": [
    {
      "type": "device",
      "name": "device",
      "filter": "driver_id=intelligent-heatpump-modbus"
    },
    {
      "type": "dropdown",
      "name": "target",
      "title": {
        "en": "Apply to",
        "nl": "Toepassen op",
        "de": "Anwenden auf",
        "fr": "Appliquer à"
      },
      "values": [
        {
          "id": "auto",
          "label": {
            "en": "Auto (follow current mode)",
            "nl": "Auto (volg huidige modus)",
            "de": "Auto (aktuellem Modus folgen)",
            "fr": "Auto (suivre le mode actuel)"
          }
        },
        {
          "id": "heating",
          "label": {
            "en": "Heating",
            "nl": "Verwarmen",
            "de": "Heizen",
            "fr": "Chauffage"
          }
        },
        {
          "id": "cooling",
          "label": {
            "en": "Cooling",
            "nl": "Koelen",
            "de": "Kühlen",
            "fr": "Refroidissement"
          }
        },
        {
          "id": "floor",
          "label": {
            "en": "Floor heating",
            "nl": "Vloerverwarming",
            "de": "Fußbodenheizung",
            "fr": "Plancher chauffant"
          }
        },
        {
          "id": "hot_water",
          "label": {
            "en": "Hot water",
            "nl": "Warm water",
            "de": "Warmwasser",
            "fr": "Eau chaude"
          }
        }
